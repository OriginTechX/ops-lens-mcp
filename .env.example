# ops-lens-mcp Environment Variables
# Copy this file to .env and adjust values for your environment.
# Never commit real credentials, IPs, or private keys to git!
#
# NOTE: You can define any custom variable names you like!
# Just make sure the variable names here match the ${VAR_NAME} placeholders in config.yaml.

# -------------------------------------------------------------
# Global Defaults
# -------------------------------------------------------------
MAX_LOG_LINES=250
MAX_BYTES=65536
STRIP_ANSI=true

# -------------------------------------------------------------
# Kubernetes Target Settings
# -------------------------------------------------------------
KUBECONFIG=~/.kube/config
PROD_K8S_CONTEXT=default
PROD_K8S_NAMESPACE=default

# -------------------------------------------------------------
# Remote VPS 1: Staging Backend / API
# -------------------------------------------------------------
STAGING_SSH_HOST=staging.example.com
STAGING_SSH_PORT=22
STAGING_SSH_USER=ai-diag
STAGING_SSH_KEY=~/.ssh/id_ed25519
STAGING_COMPOSE_PATH=/opt/app/docker-compose.yml

# -------------------------------------------------------------
# Remote VPS 2: Worker / Secondary Service (Optional)
# -------------------------------------------------------------
WORKER_SSH_HOST=192.168.1.120
WORKER_SSH_PORT=22
WORKER_SSH_USER=ai-diag
WORKER_SSH_KEY=~/.ssh/id_ed25519
WORKER_COMPOSE_PATH=/opt/worker/docker-compose.yml

# -------------------------------------------------------------
# Example of Custom-Named VPS (e.g. Media Hub, Tokyo Node, Database)
# You can add as many custom-named variables as you need!
# -------------------------------------------------------------
# MY_CUSTOM_VPS_HOST=10.0.0.15
# MY_CUSTOM_VPS_PORT=2202
# MY_CUSTOM_VPS_USER=ubuntu
# MY_CUSTOM_VPS_KEY=~/.ssh/custom_key
# MY_CUSTOM_COMPOSE_PATH=/srv/docker-compose.yml
